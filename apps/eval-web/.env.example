# Postgres connection string for the eval app + pg-boss job queue.
DATABASE_URL=postgres://user:password@localhost:5432/eval_web

# Default OpenRouter attribution (identity for this app, not Chorus).
OPENROUTER_REFERER=https://your-eval-app.example
OPENROUTER_TITLE=Model Eval

# Auth: placeholder. Wire a real provider before any non-local deployment.
AUTH_SECRET=change-me
