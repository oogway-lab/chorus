# Postgres connection string for the eval app + pg-boss job queue.
DATABASE_URL=postgres://user:password@localhost:5432/eval_web

# OpenAI API key. Local/dev fallback — once per-team key storage lands, keys come
# from the database per team and this is only used when no team key is configured.
OPENAI_API_KEY=sk-...

# Auth: placeholder. Wire a real provider before any non-local deployment.
AUTH_SECRET=change-me
